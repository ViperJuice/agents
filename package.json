{
  "name": "@viperjuice/agents",
  "private": true,
  "description": "Fleet Pi agent packages and extensions for coding harnesses.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "new-agent": "bash scripts/new-agent.sh",
    "link-fleet": "bash scripts/link-fleet.sh",
    "validate": "node scripts/validate-packages.mjs",
    "smoke": "bash scripts/smoke-agent.sh",
    "agent": "tsx scripts/run-agent.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.3",
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "pi-web-access": "0.13.0",
    "typebox": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0"
}
